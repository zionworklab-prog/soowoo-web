# Notion Integration을 만들고 (https://www.notion.so/my-integrations) 발급받은 토큰
NOTION_TOKEN=

# 술 메뉴가 들어있는 Notion 데이터베이스의 ID
# (DB 페이지 URL의 32자리 문자열, 예: https://www.notion.so/xxxx/1234abcd...?v=... 에서 1234abcd... 부분)
NOTION_DATABASE_ID=

# 손님 후기를 저장할 Postgres 연결 문자열 (선택, README의 "손님 후기 설정" 참고)
# Vercel 대시보드 Storage 탭에서 Postgres(Neon) 데이터베이스를 만들고
# 프로젝트에 연결하면 자동으로 채워진다. 로컬 개발용으로는
# `vercel env pull .env.local`로 그대로 받아올 수 있다.
DATABASE_URL=
